# ── OZ-POS .dockerignore ────────────────────────────────────────────
#
# Exclude everything that is not needed for building the cloud-server
# binary: node_modules, Tauri build artifacts, IDE configs, etc.

# Version control
.git
.gitignore
.gitattributes
.gitmodules
.githooks

# CI / GitHub
.github

# Documentation & design docs (not needed at compile time)
docs

# Front-end (Node.js / Tauri) — not needed for cloud-server, except the
# single JSON that oz-core embeds at compile time (include_str! in
# crates/oz-core/src/topology.rs). The negations below re-include just that
# file, keeping node_modules and the rest of ui/ out of the build context.
ui/*
!ui/src/
!ui/src/features/
!ui/src/features/stores/
!ui/src/features/stores/topologySemantics.json
node_modules
apps/desktop-client
apps/tablet-client

# IDE / editor configs
.vscode
.idea
*.swp
*.swo

# OS garbage
.DS_Store
Thumbs.db

# Rust build artifacts (will be rebuilt in the container)
target

# Environment / secrets
.env
*.env
oz-pos-updater.key.pub

# Temporary / generated files
*.log
*.tmp
Cargo.lock.bak
