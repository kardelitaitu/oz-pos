{
  "comment": "Shared password-policy fixture. Consumed by BOTH sides so the Go server policy (isValidPassword / passwordClassCount in apps/license-server/web_password.go) and the client meter (passwordClassCount / isStrongPassword in website/src/lib/passwordPolicy.ts) can never drift apart: apps/license-server/web_password_test.go asserts the Go policy against these cases, and website/scripts/check-password-policy.mjs (npm run precheck/prebuild) asserts the TypeScript policy against the same file. Add a case here and both sides must agree on it.",
  "minLength": 8,
  "maxBytes": 72,
  "minClasses": 3,
  "cases": [
    { "password": "Password1!", "classes": 4, "valid": true },
    { "password": "passw0rd!", "classes": 3, "valid": true },
    { "password": "PASSWORD1!", "classes": 3, "valid": true },
    { "password": "abcDEF123", "classes": 3, "valid": true },
    { "password": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxA1", "classes": 3, "valid": true },
    { "password": "😀😀😀😀😀😀😀😀aA1", "classes": 4, "valid": true },
    { "password": "", "classes": 0, "valid": false },
    { "password": "short", "classes": 1, "valid": false },
    { "password": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "classes": 1, "valid": false },
    { "password": "password123", "classes": 2, "valid": false },
    { "password": "PASSWORD123", "classes": 2, "valid": false },
    { "password": "abcdefgh", "classes": 1, "valid": false },
    { "password": "!!!!!!!!", "classes": 1, "valid": false },
    { "password": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "classes": 1, "valid": false },
    { "password": "  password123!", "classes": 3, "valid": false },
    { "password": "password123!  ", "classes": 3, "valid": false },
    { "password": "😀😀😀😀😀😀😀😀", "classes": 1, "valid": false }
  ]
}
