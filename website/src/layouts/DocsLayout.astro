---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DocSidebar, { type CategoryGroup } from '../components/DocSidebar.astro';
import { t } from '../i18n';
import '../styles/global.css';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  locale: string;
  title: string;
  description?: string;
  entries: CategoryGroup[];
  currentSlug?: string;
  headings?: Heading[];
}

const { locale, title, description, entries, currentSlug, headings } = Astro.props;
const toc = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description ?? t(locale, 'docs.title')} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OZ-POS" />
    <meta property="og:locale" content={locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description ?? t(locale, 'docs.title')} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={new URL('/og-image.svg', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title} — {t(locale, 'docs.title')}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-primary text-ink antialiased">
    <Header />

    <!-- Mobile sidebar (collapsible) -->
    <details class="border-b border-ink/5 md:hidden">
      <summary class="px-4 py-3 text-sm font-semibold">{t(locale, 'docs.title')}</summary>
      <div class="px-4 pb-4">
        <DocSidebar locale={locale} entries={entries} currentSlug={currentSlug} />
      </div>
    </details>

    <div class="mx-auto flex w-full max-w-7xl flex-1">
      <!-- Desktop sidebar -->
      <aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-60 shrink-0 overflow-y-auto border-r border-ink/5 px-4 py-8 md:block">
        <p class="px-2 text-xs font-semibold uppercase tracking-wide text-muted">
          {t(locale, 'docs.title')}
        </p>
        <DocSidebar locale={locale} entries={entries} currentSlug={currentSlug} />
      </aside>

      <main class="min-w-0 flex-1 px-4 py-10 sm:px-8">
        <article class="docs-content mx-auto max-w-3xl">
          <h1 class="text-3xl font-bold">{title}</h1>
          {description && <p class="mt-3 text-muted">{description}</p>}
          <div class="mt-8">
            <slot />
          </div>
        </article>
      </main>

      <!-- On-this-page TOC -->
      {
        toc.length > 0 && (
          <aside class="sticky top-16 hidden h-[calc(100vh-4rem)] w-56 shrink-0 overflow-y-auto px-4 py-8 xl:block">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">
              {t(locale, 'docs.onThisPage')}
            </p>
            <ul class="mt-3 space-y-1.5 text-sm">
              {
                toc.map((h) => (
                  <li class:list={[h.depth === 3 ? 'pl-3' : '']}>
                    <a href={`#${h.slug}`} class="text-muted transition hover:text-ink">
                      {h.text}
                    </a>
                  </li>
                ))
              }
            </ul>
          </aside>
        )
      }
    </div>

    <Footer />
  </body>
</html>
