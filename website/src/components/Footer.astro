---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t, dict } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const year = new Date().getFullYear();
// Vertical entry points (subscription-tiers.md §5).
const verticalKeys = ['kafe', 'minimarket', 'warung', 'restoran'] as const;
const verticals = dict(locale).vertical as Record<(typeof verticalKeys)[number], { label: string }>;
---

<footer class="border-t border-ink/5 bg-surface/40">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-4 py-8 sm:flex-row">
    <div class="flex items-center gap-4">
      <p class="text-xs text-muted">
        © {year} OZ-POS. {t(locale, 'footer.rights')}
      </p>
      <a
        href="https://discord.gg/NdWDgEzNxx"
        target="_blank"
        rel="noopener noreferrer"
        class="text-muted transition-colors duration-200 hover:text-[#5865F2]"
        aria-label="Discord"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
          <path d="M20.317 4.369a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.332-.946 2.418-2.157 2.418z"/>
        </svg>
      </a>
    </div>
    <nav class="flex flex-wrap justify-center gap-4 text-xs text-muted" aria-label={t(locale, 'footer.business')}>
      {
        verticalKeys.map((key) => (
          <a href={getRelativeLocaleUrl(locale, `untuk-${key}`)} class="footer-link relative transition-colors duration-200 hover:text-ink">
            {verticals[key].label}
            <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
          </a>
        ))
      }
    </nav>
    <nav class="flex gap-4 text-xs text-muted" aria-label={t(locale, 'footer.legal')}>
      <a href={getRelativeLocaleUrl(locale, 'legal/privacy')} class="footer-link relative transition-colors duration-200 hover:text-ink">
        {t(locale, 'footer.privacy')}
        <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>
      <a href={getRelativeLocaleUrl(locale, 'legal/terms')} class="footer-link relative transition-colors duration-200 hover:text-ink">
        {t(locale, 'footer.terms')}
        <span class="footer-underline absolute -bottom-0.5 left-0 h-px w-0 bg-primary transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
      </a>
    </nav>
  </div>
</footer>
