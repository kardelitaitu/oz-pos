---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';
import LocaleSwitcher from './LocaleSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import SearchTrigger from './SearchTrigger';

const locale = Astro.currentLocale ?? 'en';
const isDocs = Astro.url.pathname.includes('/docs');
const nav = [
  { href: getRelativeLocaleUrl(locale, '/'), label: t(locale, 'nav.home') },
  { href: getRelativeLocaleUrl(locale, 'features'), label: t(locale, 'nav.features') },
  { href: getRelativeLocaleUrl(locale, 'pricing'), label: t(locale, 'nav.pricing') },
  { href: getRelativeLocaleUrl(locale, 'download'), label: t(locale, 'nav.download') },
  { href: getRelativeLocaleUrl(locale, 'support'), label: t(locale, 'nav.support') },
  { href: getRelativeLocaleUrl(locale, 'docs'), label: t(locale, 'nav.docs') },
];
const home = getRelativeLocaleUrl(locale, '/');
const login = getRelativeLocaleUrl(locale, 'login');
---

<header class="sticky top-0 z-40 border-b border-ink/10 bg-surface/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a href={home} class="text-lg font-bold tracking-tight" aria-label={t(locale, 'nav.homeAria')}>
      <span class="text-primary">OZ</span>-POS
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label={t(locale, 'nav.mainNav')}>
      {
        nav.map((item) => (
          <a href={item.href} class="nav-link relative text-sm text-muted transition-colors duration-200 hover:text-ink">
            {item.label}
            <span class="nav-underline absolute -bottom-1 left-0 h-0.5 w-0 bg-primary rounded-full transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]"></span>
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-2.5">
      {isDocs && <SearchTrigger client:load locale={locale} />}
      <ThemeToggle />
      <LocaleSwitcher />
      <a
        href={login}
        data-auth-nav
        data-locale={locale}
        data-login-text={t(locale, 'nav.login')}
        data-account-text={t(locale, 'nav.account')}
        class="hidden rounded-md bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary sm:inline-block opacity-90 hover:opacity-100"
      >
        {t(locale, 'nav.login')}
      </a>
      <!-- Mobile menu -->
      <details class="group relative md:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-md border border-ink/10 text-muted transition hover:text-ink [&::-webkit-details-marker]:hidden"
          aria-label={t(locale, 'nav.menu')}
        >
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 4.5h14M2 9h14M2 13.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 w-56 rounded-xl border border-ink/10 bg-surface p-2 shadow-xl"
          aria-label={t(locale, 'nav.menu')}
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class="block rounded-md px-3 py-2 text-sm text-muted transition hover:bg-ink/5 hover:text-ink"
              >
                {item.label}
              </a>
            ))
          }
          <a
            href={login}
            data-auth-nav
            data-locale={locale}
            data-login-text={t(locale, 'nav.login')}
            data-account-text={t(locale, 'nav.account')}
            class="mt-1 block rounded-md bg-primary px-3 py-2 text-center text-sm font-semibold text-white transition opacity-90 hover:opacity-100"
          >
            {t(locale, 'nav.login')}
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  function updateAuthNav() {
    const isAuth = Boolean(sessionStorage.getItem('oz_session'));
    const loginLinks = document.querySelectorAll<HTMLAnchorElement>('[data-auth-nav]');
    loginLinks.forEach((link) => {
      const loc = link.getAttribute('data-locale') || 'en';
      if (isAuth) {
        link.href = `/${loc}/account`;
        link.textContent = link.getAttribute('data-account-text') || 'Account';
      } else {
        link.href = `/${loc}/login`;
        link.textContent = link.getAttribute('data-login-text') || 'Sign in';
      }
    });
  }

  // Update on initial load, after SPA page swap, and on storage change
  updateAuthNav();
  document.addEventListener('astro:page-load', updateAuthNav);
  document.addEventListener('astro:after-swap', updateAuthNav);
  window.addEventListener('storage', updateAuthNav);

  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement)?.closest('details.group a');
    if (link) {
      const details = link.closest('details');
      if (details) details.removeAttribute('open');
    }
  });
</script>
