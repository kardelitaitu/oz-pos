---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, t } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'id';
// Strip the locale prefix so the toggle keeps the same page in the other locale.
const path = Astro.url.pathname.replace(/^\/(?:en|id)(?:\/|$)/, '');
---

<div
  class="flex items-center rounded-full border border-ink/10 bg-primary p-0.5"
  role="group"
  aria-label={t(locale, 'nav.language')}
>
  {
    locales.map((code) => (
      <a
        href={getRelativeLocaleUrl(code, path || '/')}
        aria-current={locale === code ? 'page' : undefined}
        class:list={[
          'rounded-full px-3 py-1.5 text-xs font-semibold transition',
          locale === code ? 'bg-accent text-black' : 'text-muted hover:text-ink',
        ]}
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</div>
