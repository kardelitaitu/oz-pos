---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { locales, t } from '../i18n';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'id';
const path = Astro.url.pathname.replace(/^\/(?:en|id)(?:\/|$)/, '');
const target = !path || path.replace(/^\/+/, '').startsWith('404') ? '/' : path;
const activeIndex = locales.indexOf(locale);
---

<div
  class="lang-switcher relative flex items-center rounded-lg p-[3px] bg-ghost-bg"
  role="group"
  aria-label={t(locale, 'nav.language')}
  data-active-index={activeIndex}
>
  <!-- Sliding blue pill indicator — design-language: ms-indicator -->
  <div
    class="pill absolute top-[3px] bottom-[3px] rounded-lg bg-primary transition-all duration-[280ms] ease-[cubic-bezier(0.33,1,0.68,1)]"
    style={`left: calc(${activeIndex} * 50% + 3px); width: calc(50% - 3px);`}
    aria-hidden="true"
  ></div>

  {
    locales.map((code, i) => (
      <a
        href={getRelativeLocaleUrl(code, target)}
        aria-current={locale === code ? 'page' : undefined}
        class:list={[
          'relative z-10 flex-1 px-[9px] py-[5px] rounded-lg text-[13px] font-semibold transition-opacity duration-200 text-center',
          locale === code ? 'text-white opacity-100' : 'text-muted opacity-50 hover:opacity-100',
        ]}
        data-index={i}
      >
        {code.toUpperCase()}
      </a>
    ))
  }
</div>

<script>
  function initLangSwitcher() {
    const switcher = document.querySelector('.lang-switcher') as HTMLElement | null;
    if (!switcher) return;

    const pill = switcher.querySelector('.pill') as HTMLElement | null;
    const links = switcher.querySelectorAll('a[data-index]');
    if (!pill || !links.length) return;

    function updatePillPosition(index: number) {
      pill!.style.left = `calc(${index} * 50% + 3px)`;
      pill!.style.width = 'calc(50% - 3px)';
    }

    // Intercept clicks: animate pill first, then navigate after transition
    links.forEach((link) => {
      link.addEventListener('click', (e) => {
        const idx = parseInt((link as HTMLElement).dataset.index || '0');
        const currentIdx = parseInt(switcher!.dataset.activeIndex || '0');
        // If already on this language, do nothing
        if (idx === currentIdx) {
          e.preventDefault();
          return;
        }
        // Prevent immediate navigation
        e.preventDefault();
        // Slide pill to clicked option
        switcher!.dataset.activeIndex = String(idx);
        updatePillPosition(idx);
        // Navigate after pill animation completes (280ms matches CSS transition)
        setTimeout(() => {
          window.location.href = link.getAttribute('href') || '#';
        }, 280);
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initLangSwitcher);
  document.addEventListener('astro:page-load', initLangSwitcher);
</script>
