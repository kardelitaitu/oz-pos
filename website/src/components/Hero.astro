---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { t } from '../i18n';

const locale = Astro.currentLocale ?? 'en';
const download = getRelativeLocaleUrl(locale, 'download');
const pricing = getRelativeLocaleUrl(locale, 'pricing');
---

<section class="mx-auto max-w-7xl px-4 pb-16 pt-20 text-center sm:pt-28">
  <h1 class="mx-auto max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
    {t(locale, 'hero.title')}
  </h1>
  <p class="mx-auto mt-6 max-w-2xl text-lg text-muted">{t(locale, 'hero.subtitle')}</p>
  <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      href={download}
      class="rounded-md bg-primary px-6 py-3 text-base font-semibold text-white transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-primary-hover hover:scale-[1.03] active:scale-[0.97] hover:shadow-lg"
    >
      {t(locale, 'hero.ctaPrimary')}
    </a>
    <a
      href={pricing}
      class="rounded-md border border-ink/15 px-6 py-3 text-base font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
    >
      {t(locale, 'hero.ctaSecondary')}
    </a>
  </div>
  
  <!-- Hero Mockup - 1280x720 -->
  <div class="mt-12 mx-auto max-w-[1280px]">
    <div
      class="relative overflow-hidden rounded-2xl border border-ink/10 bg-gradient-to-br from-[#f8f9fa] via-[#f0f1f3] to-[#e8e9eb] shadow-2xl shadow-black/30"
      style="aspect-ratio: 1280 / 720;"
      aria-hidden="true"
    >
      <!-- Window chrome -->
      <div class="flex items-center gap-2 border-b border-ink/10 bg-white/80 px-4 py-1.5">
        <span class="h-2.5 w-2.5 rounded-full bg-red-400"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-yellow-400"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-green-400"></span>
        <span class="ml-4 text-[11px] text-muted font-medium">OZ-POS — Point of Sale</span>
      </div>
      
      <!-- POS Interface Content -->
      <div class="grid grid-cols-12 gap-4 p-6 h-full">
        <!-- Sidebar -->
        <div class="col-span-2 space-y-3">
          <div class="rounded-lg bg-white/80 p-3 shadow-sm border border-ink/5">
            <div class="flex items-center gap-2 mb-3">
              <div class="h-8 w-8 rounded-full bg-accent/20 flex items-center justify-center text-accent text-xs font-bold">D</div>
              <div>
                <p class="text-xs font-semibold">Dewi</p>
                <p class="text-[10px] text-muted">Kasir</p>
              </div>
            </div>
            <div class="space-y-1.5">
              <div class="rounded-md bg-accent/10 px-2 py-1.5 text-[10px] font-medium text-accent">Penjualan</div>
              <div class="rounded-md px-2 py-1.5 text-[10px] text-muted hover:bg-ink/5">Menu</div>
              <div class="rounded-md px-2 py-1.5 text-[10px] text-muted hover:bg-ink/5">Pesanan</div>
              <div class="rounded-md px-2 py-1.5 text-[10px] text-muted hover:bg-ink/5">Laporan</div>
            </div>
          </div>
        </div>
        
        <!-- Main Content -->
        <div class="col-span-7 space-y-4">
          <!-- Category Tabs -->
          <div class="flex gap-2">
            <span class="rounded-full bg-accent px-4 py-2 text-xs font-medium text-white">Semua</span>
            <span class="rounded-full bg-white/80 px-4 py-2 text-xs text-muted border border-ink/10">Kopi</span>
            <span class="rounded-full bg-white/80 px-4 py-2 text-xs text-muted border border-ink/10">Makanan</span>
            <span class="rounded-full bg-white/80 px-4 py-2 text-xs text-muted border border-ink/10">Minuman</span>
            <span class="rounded-full bg-white/80 px-4 py-2 text-xs text-muted border border-ink/10">Camilan</span>
          </div>
          
          <!-- Product Grid -->
          <div class="grid grid-cols-4 gap-3">
            {[
              ['Kopi Tubruk', '18.000', '☕'],
              ['Kopi Susu', '22.000', '🥛'],
              ['Nasi Goreng', '25.000', '🍚'],
              ['Mie Goreng', '23.000', '🍜'],
              ['Es Teh Manis', '8.000', '🧊'],
              ['Es Jeruk', '12.000', '🍊'],
              ['Roti Bakar', '15.000', '🍞'],
              ['Pisang Goreng', '10.000', '🍌'],
            ].map(([name, price, emoji]) => (
              <div class="mockup-card rounded-xl bg-white/90 p-4 shadow-sm border border-ink/5 hover:border-accent/30 hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 cursor-pointer">
                <div class="text-2xl mb-2 transition-transform duration-200">{emoji}</div>
                <p class="text-xs font-semibold text-ink/90">{name}</p>
                <p class="mt-1 text-[11px] font-medium text-accent">Rp {price}</p>
              </div>
            ))}
          </div>
        </div>
        
        <!-- Cart Panel -->
        <div class="col-span-3">
          <div class="rounded-xl bg-white/90 p-4 shadow-sm border border-ink/5 h-full flex flex-col">
            <div class="flex justify-between items-center mb-4">
              <h3 class="text-sm font-semibold">Pesanan Baru</h3>
              <span class="text-[10px] text-muted bg-ink/5 px-2 py-1 rounded">#1042</span>
            </div>
            
            <div class="flex-1 space-y-3 mb-4">
              {[
                ['Kopi Tubruk', '×2', '36.000'],
                ['Nasi Goreng', '×1', '25.000'],
                ['Es Teh Manis', '×1', '8.000'],
              ].map(([item, qty, price]) => (
                <div class="flex justify-between items-start text-xs">
                  <div>
                    <p class="font-medium">{item}</p>
                    <p class="text-muted text-[10px]">{qty}</p>
                  </div>
                  <span class="text-muted">Rp {price}</span>
                </div>
              ))}
            </div>
            
            <div class="border-t border-ink/10 pt-3 space-y-3">
              <div class="flex justify-between text-sm font-bold">
                <span>Total</span>
                <span class="text-accent">Rp 69.000</span>
              </div>
              <div class="mockup-btn rounded-lg bg-gradient-to-r from-blue-500 to-blue-600 py-3 text-center text-sm font-bold text-white shadow-md cursor-pointer hover:shadow-lg hover:scale-[1.03] active:scale-[0.97] transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)]">
                Bayar · QRIS
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
