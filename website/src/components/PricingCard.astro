---
import { getRelativeLocaleUrl } from 'astro:i18n';
import type { PricingTier } from '../content/pricing/types';
import CheckoutButton from './CheckoutButton.tsx';

interface Props {
  tier: PricingTier;
}

const { tier } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const trialHref = getRelativeLocaleUrl(locale, 'download');
const hasCheckout = Boolean(tier.priceId && import.meta.env.PUBLIC_PADDLE_CLIENT_TOKEN);
const contactHref = 'mailto:sales@oz-pos.com';
---

<article
  class:list={[
    'flex flex-col rounded-xl border p-6',
    tier.highlight ? 'border-accent bg-surface' : 'border-ink/10 bg-surface/40',
  ]}
>
  <h3 class="text-lg font-semibold">{tier.name}</h3>
  <p class="mt-3 text-3xl font-bold">
    {tier.price}
    {tier.period && <span class="text-sm font-normal text-muted"> {tier.period}</span>}
  </p>
  <p class="mt-2 text-sm text-muted">{tier.description}</p>

  <div class="mt-6">
    {
      tier.priceId ? (
        hasCheckout ? (
          <CheckoutButton client:load tier={tier} locale={locale} />
        ) : (
          <a
            href={contactHref}
            class="block w-full rounded-md border border-ink/15 px-4 py-2.5 text-center text-sm font-semibold text-ink transition hover:bg-ink/5"
          >
            {tier.cta}
          </a>
        )
      ) : tier.tierKey === 'trial' ? (
        <a
          href={trialHref}
          class="block w-full rounded-md bg-accent px-4 py-2.5 text-center text-sm font-semibold text-black transition hover:opacity-90"
        >
          {tier.cta}
        </a>
      ) : (
        <a
          href={contactHref}
          class="block w-full rounded-md border border-ink/15 px-4 py-2.5 text-center text-sm font-semibold text-ink transition hover:bg-ink/5"
        >
          {tier.cta}
        </a>
      )
    }
  </div>

  <ul class="mt-6 space-y-2 text-sm">
    {tier.features.map((f) => (
      <li class:list={['flex items-center gap-2', f.included ? '' : 'text-muted']}>
        <span aria-hidden="true" class:list={[f.included ? 'text-link' : 'text-muted/50']}>
          {f.included ? '✓' : '✗'}
        </span>
        {f.label}
      </li>
    ))}
  </ul>
</article>
