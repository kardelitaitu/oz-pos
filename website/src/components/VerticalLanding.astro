---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { dict } from '../i18n';

/**
 * Vertical landing page body (subscription-tiers.md §5). Customers don't
 * identify as "Pro tier users" — they identify as cafe owners, minimarket
 * operators, or warung owners — so these pages lead with vertical language
 * and the OZ-POS positioning statement, never tier names. Each vertical has
 * an entry hook, highlighted features, and a CTA that deep-links to the
 * natural tier on the pricing page (kafe/minimarket → Pro, warung → Plus,
 * restoran → Premium).
 */
export type VerticalKey = 'kafe' | 'minimarket' | 'warung' | 'restoran';

export const verticalKeys: VerticalKey[] = ['kafe', 'minimarket', 'warung', 'restoran'];

interface VerticalFeature {
  title: string;
  description: string;
}

interface VerticalContent {
  label: string;
  title: string;
  tagline: string;
  tierAnchor: string;
  ctaPrimary: string;
  features: VerticalFeature[];
  benefits: string[];
}

interface VerticalSection {
  positioning: string;
  whyTitle: string;
  otherTitle: string;
  otherSubtitle: string;
  ctaSecondary: string;
  kafe: VerticalContent;
  minimarket: VerticalContent;
  warung: VerticalContent;
  restoran: VerticalContent;
}

interface Props {
  vertical: VerticalKey;
}

const { vertical } = Astro.props;
const locale = Astro.currentLocale ?? 'en';
const section = dict(locale).vertical as VerticalSection;
const v = section[vertical];
const pricingHref = getRelativeLocaleUrl(locale, 'pricing');
const downloadHref = getRelativeLocaleUrl(locale, 'download');
const tierHref = `${pricingHref}#${v.tierAnchor}`;
---

<section class="mx-auto max-w-6xl px-4 py-16">
  <div class="mx-auto max-w-3xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-link">{section.positioning}</p>
    <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{v.title}</h1>
    <p class="mt-4 text-lg text-muted">{v.tagline}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={tierHref}
        class="rounded-md bg-accent px-6 py-3 text-base font-semibold text-black transition hover:opacity-90"
      >
        {v.ctaPrimary}
      </a>
      <a
        href={downloadHref}
        class="rounded-md border border-ink/15 px-6 py-3 text-base font-semibold text-ink transition hover:bg-ink/5"
      >
        {section.ctaSecondary}
      </a>
    </div>
  </div>

  <div class="mt-16 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      v.features.map((f) => (
        <article class="rounded-xl border border-ink/10 bg-surface/40 p-6">
          <h2 class="text-lg font-semibold">{f.title}</h2>
          <p class="mt-2 text-sm text-muted">{f.description}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-16 rounded-2xl border border-accent/30 bg-surface/60 p-8 sm:p-10">
    <h2 class="text-xl font-semibold">{section.whyTitle}</h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {
        v.benefits.map((b) => (
          <li class="flex items-start gap-2 text-sm text-muted">
            <span aria-hidden="true" class="text-link">✓</span>
            {b}
          </li>
        ))
      }
    </ul>
  </div>

  <div class="mt-16 text-center">
    <h2 class="text-xl font-semibold">{section.otherTitle}</h2>
    <p class="mt-2 text-sm text-muted">{section.otherSubtitle}</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      {
        verticalKeys
          .filter((key) => key !== vertical)
          .map((key) => (
            <a
              href={getRelativeLocaleUrl(locale, `untuk-${key}`)}
              class="rounded-full border border-ink/10 px-4 py-2 text-sm text-muted transition hover:border-accent hover:text-ink"
            >
              {section[key].label}
            </a>
          ))
      }
    </div>
  </div>
</section>
