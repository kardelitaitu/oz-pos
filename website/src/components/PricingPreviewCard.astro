---
import type { PricingTier } from '../content/pricing/types';
import { t } from '../i18n';

interface Props {
  tier: PricingTier;
  locale: string;
}

const { tier, locale } = Astro.props;
// Annual is the default selection on the full pricing page (subscription-tiers.md §2).
const price = tier.prices.yearly;
---

<article
  class:list={[
    'pricing-card flex flex-col rounded-xl border p-6 transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)]',
    tier.highlight ? 'border-accent bg-surface hover:shadow-lg hover:-translate-y-1' : 'border-ink/10 bg-surface/40 hover:border-ink/20 hover:shadow-md hover:-translate-y-0.5',
  ]}
>
  {
    tier.highlight && (
      <span class="mb-3 inline-flex w-fit items-center rounded-full bg-accent px-2.5 py-0.5 text-xs font-semibold text-white">
        {t(locale, 'pricingPage.mostPopular')}
      </span>
    )
  }
  <h3 class="text-lg font-semibold">{tier.name}</h3>
  <p class="mt-3 text-3xl font-bold">
    {price.price}
    {price.period && <span class="text-sm font-normal text-muted"> {price.period}</span>}
  </p>
  <p class="mt-2 text-sm text-muted">{tier.description}</p>

  <ul class="mt-6 space-y-2 text-sm">
    {tier.features.map((f) => (
      <li class:list={['flex items-center gap-2', f.included ? '' : 'text-muted']}>
        <span aria-hidden="true" class:list={[f.included ? 'text-link' : 'text-muted/50']}>
          {f.included ? '✓' : '✗'}
        </span>
        {f.label}
      </li>
    ))}
  </ul>
</article>
