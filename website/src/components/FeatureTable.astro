---
import type { FeatureRow, PricingTier } from '../content/pricing/types';
import { t } from '../i18n';

interface Props {
  rows: FeatureRow[];
  /** Only tierKey + name are rendered (prices live in the card grid). */
  columns: Pick<PricingTier, 'tierKey' | 'name'>[];
}

const { rows, columns } = Astro.props;
const locale = Astro.currentLocale ?? 'en';

function cell(value: boolean | string | number): string {
  return String(value);
}

function cellHtml(value: boolean | string | number): string {
  if (value === true) return '<span class="text-green-400 font-bold">✓</span>';
  if (value === false) return '<span class="text-red-400 font-bold">✗</span>';
  return String(value);
}
---

<div class="overflow-x-auto rounded-lg border border-ink/10">
  <table class="w-full min-w-[560px] border-collapse text-left text-sm">
    <caption class="sr-only">{t(locale, 'pricingPage.comparison')}</caption>
    <thead>
      <tr class="border-b border-ink/10">
        <th scope="col" class="px-4 py-3 text-muted"> </th>
        {
          columns.map((c) => (
            <th scope="col" class="px-4 py-3 font-semibold">
              {c.name}
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-b border-ink/5 last:border-0">
            <th scope="row" class="px-4 py-3 font-normal text-muted">
              {row.label}
            </th>
            {columns.map((c) => (
              <td class="px-4 py-3" set:html={cellHtml(row.values[c.tierKey])} />
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
