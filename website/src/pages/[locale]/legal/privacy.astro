---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../../layouts/Base.astro';
import { t } from '../../../i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'legal.privacyTitle')}`;
---

<Base title={pageTitle} description={t(locale, 'pageDesc.privacy')}>
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-bold">{t(locale, 'legal.privacyTitle')}</h1>
    <p class="mt-4 text-muted">{t(locale, 'legal.placeholder')}</p>
  </section>
</Base>
