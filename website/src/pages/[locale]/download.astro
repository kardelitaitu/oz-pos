---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import { t, dict } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'download.title')}`;
const releaseUrl = 'https://github.com/kardelitaitu/oz-pos/releases';
// Only Windows ships today; the other four are on the roadmap and render a
// "coming soon" badge instead of a download link. Flip `ready` to true when
// a platform's installers start publishing (website-plan.md §8).
type Platform = 'windows' | 'macos' | 'linux' | 'android' | 'ios';
const platforms: { name: string; os: string; platform: Platform; ready: boolean }[] = [
  { name: 'Windows', os: 'Windows 10 / 11', platform: 'windows', ready: true },
  { name: 'macOS', os: 'macOS 12+', platform: 'macos', ready: false },
  { name: 'Linux', os: 'x86_64 · glibc 2.31+', platform: 'linux', ready: false },
  { name: 'Android', os: 'Tablets & phones', platform: 'android', ready: false },
  { name: 'iOS', os: 'Tablets & phones', platform: 'ios', ready: false },
];
const reqList = (dict(locale).download as { requirements: string[] }).requirements;
---

<Base title={pageTitle} description={t(locale, 'pageDesc.download')}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'download.title')}</h1>
      <p class="mt-3 text-muted">{t(locale, 'download.subtitle')}</p>
    </div>

    <h2 class="mt-14 text-lg font-semibold">{t(locale, 'download.platformsTitle')}</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        platforms.map((p) => (
          <div class="rounded-xl border border-ink/10 bg-surface/40 p-6 text-center">
            <PlatformIcon platform={p.platform} class="mx-auto h-10 w-10" />
            <h3 class="mt-3 font-semibold">{p.name}</h3>
            <p class="mt-1 text-xs text-muted">{p.os}</p>
            {
              p.ready ? (
                <a
                  href={releaseUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-5 inline-block w-full rounded-md bg-accent px-4 py-2.5 text-sm font-semibold text-black transition hover:opacity-90"
                >
                  {t(locale, 'download.title')} — {p.name}
                </a>
              ) : (
                <span
                  class="mt-5 inline-block w-full rounded-md border border-ink/10 px-4 py-2.5 text-center text-sm font-semibold text-muted"
                  aria-hidden="true"
                >
                  {t(locale, 'download.comingSoon')}
                </span>
              )
            }
          </div>
        ))
      }
    </div>

    <div class="mt-14 grid gap-8 md:grid-cols-2">
      <section aria-label={t(locale, 'download.version')}>
        <h2 class="text-lg font-semibold">{t(locale, 'download.version')}</h2>
        <p class="mt-3 font-mono text-2xl">{t(locale, 'download.versionValue')}</p>
        <p class="mt-4 text-sm text-muted">{t(locale, 'download.note')}</p>
        <a
          href={releaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-2 inline-block text-sm font-semibold text-link hover:underline"
        >
          {t(locale, 'download.releaseLink')} →
        </a>
      </section>
      <section aria-label={t(locale, 'download.requirementsTitle')}>
        <h2 class="text-lg font-semibold">{t(locale, 'download.requirementsTitle')}</h2>
        <ul class="mt-3 list-inside list-disc space-y-1 text-sm text-muted">
          {reqList.map((r) => <li>{r}</li>)}
        </ul>
      </section>
    </div>
  </section>
</Base>
