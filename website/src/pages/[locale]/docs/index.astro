---
import { getCollection } from 'astro:content';
import { t } from '../../../i18n';

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}

const locale = Astro.params.locale ?? 'en';
const docs = (await getCollection('docs')).filter((d) => d.id.startsWith(`${locale}/`));
const first = docs
  .filter((d) => d.data.category === 'gettingStarted')
  .sort((a, b) => a.data.order - b.data.order)[0];
// Redirect to the first Getting Started doc; fall back to the locale home if
// the collection is empty so the page can never render a broken target.
// NOTE: production serves a real 301 from public/_redirects — this meta
// refresh is the fallback for local dev/preview, so keep the two in sync.
const target = first ? `/${locale}/docs/${first.id.slice(locale.length + 1)}` : `/${locale}/`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OZ-POS — {t(locale, 'docs.title')}</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body></body>
</html>
