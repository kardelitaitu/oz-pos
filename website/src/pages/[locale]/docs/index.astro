---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}

const locale = Astro.params.locale ?? 'en';
const docs = (await getCollection('docs')).filter((d) => d.id.startsWith(`${locale}/`));
const first = docs
  .filter((d) => d.data.category === 'gettingStarted')
  .sort((a, b) => a.data.order - b.data.order)[0];
const target = `/${locale}/docs/${first.id.slice(locale.length + 1)}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Documentation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
  </head>
  <body></body>
</html>
