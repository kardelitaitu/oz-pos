---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import { t, dict } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'nav.features')}`;
const features = (dict(locale).features as { items: { title: string; description: string }[] }).items;
const download = getRelativeLocaleUrl(locale, 'download');
---

<Base title={pageTitle} description={t(locale, 'pageDesc.features')}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'features.title')}</h1>
      <p class="mt-3 text-muted">{t(locale, 'features.subtitle')}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <article
            data-reveal
            style={`transition-delay: ${i * 80}ms`}
            class="feature-card group rounded-xl border border-ink/10 bg-surface/40 p-6 transition-all duration-200 ease-[cubic-bezier(0.2,0,0,1)] hover:border-ink/20 hover:shadow-md hover:-translate-y-0.5"
          >
            <p class="text-sm font-bold text-link">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-2 text-xl font-semibold transition-colors duration-200 group-hover:text-link">{f.title}</h2>
            <p class="mt-2 text-sm text-muted">{f.description}</p>
          </article>
        ))
      }
    </div>
    <div data-reveal class="mt-12 text-center">
      <a
        href={download}
        class="inline-block rounded-md bg-accent px-6 py-3 font-semibold text-white transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t(locale, 'hero.ctaPrimary')}
      </a>
    </div>
  </section>
</Base>
