---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import { t, dict } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'nav.features')}`;
const features = (dict(locale).features as { items: { title: string; description: string }[] }).items;
const download = getRelativeLocaleUrl(locale, 'download');
---

<Base title={pageTitle} description={t(locale, 'pageDesc.features')}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'features.title')}</h1>
      <p class="mt-3 text-muted">{t(locale, 'features.subtitle')}</p>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <article class="rounded-xl border border-ink/10 bg-surface/40 p-6">
            <p class="text-sm font-bold text-link">{String(i + 1).padStart(2, '0')}</p>
            <h2 class="mt-2 text-xl font-semibold">{f.title}</h2>
            <p class="mt-2 text-sm text-muted">{f.description}</p>
          </article>
        ))
      }
    </div>
    <div class="mt-12 text-center">
      <a
        href={download}
        class="inline-block rounded-md bg-accent px-6 py-3 font-semibold text-black transition hover:opacity-90"
      >
        {t(locale, 'hero.ctaPrimary')}
      </a>
    </div>
  </section>
</Base>
