---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import { t, dict } from '../../i18n';
import { getRelativeLocaleUrl } from 'astro:i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'nav.features')}`;
const featuresData = dict(locale).features as {
  title: string;
  subtitle: string;
  items: { title: string; description: string }[];
  comparisonTitle: string;
  comparisonSubtitle: string;
  comparisonOzPos: string;
  comparisonOthers: string;
  comparisonHeaderFeature: string;
  comparisonRows: { feature: string; ozPos: string; others: string; highlight: boolean }[];
};
const features = featuresData.items;
const comparisonRows = featuresData.comparisonRows;
const download = getRelativeLocaleUrl(locale, 'download');
const pricing = getRelativeLocaleUrl(locale, 'pricing');

const featureIcons = [
  // 1. Offline-First
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>`,
  // 2. No Hardware Barrier
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" /></svg>`,
  // 3. Multi-Store & Multi-Terminal
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 7 4.41-4.41A2 2 0 0 1 7.83 2h8.34a2 2 0 0 1 1.42.59L22 7" /><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8" /><path d="M15 22v-4a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v4" /><path d="M2 7h20" /></svg>`,
  // 4. Advanced Reports & Analytics
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10" /><line x1="12" y1="20" x2="12" y2="4" /><line x1="6" y1="20" x2="6" y2="14" /><path d="m4 9 4-4 4 4 6-6" /></svg>`,
  // 5. E-Wallets & Native QRIS
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><path d="M7 7h.01M17 7h.01M7 17h.01M17 17h.01" stroke-width="3" stroke-linecap="round" /></svg>`,
  // 6. Debit & Credit Card
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2" /><line x1="2" y1="10" x2="22" y2="10" /><line x1="6" y1="15" x2="10" y2="15" /></svg>`,
  // 7. Whitelabel
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z" /></svg>`,
  // 8. Lua Scripting
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /><line x1="14" y1="4" x2="10" y2="20" /></svg>`,
  // 9. Full Audit Logging & Shift
  `<svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><circle cx="12" cy="11" r="2" /><path d="M12 13v3" /></svg>`,
];
---

<Base title={pageTitle} description={t(locale, 'pageDesc.features')}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div data-reveal class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'features.title')}</h1>
      <p class="mt-3 text-muted max-w-2xl mx-auto">{t(locale, 'features.subtitle')}</p>
    </div>

    <!-- 9 Features Grid -->
    <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        features.map((f, i) => (
          <article
            data-reveal
            style={`transition-delay: ${i * 60}ms`}
            class="feature-card group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-ink/10 bg-surface/90 p-8 shadow-sm transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] hover:-translate-y-1.5 hover:border-primary/40 hover:shadow-xl hover:shadow-primary/5"
          >
            <!-- Ambient gradient glow on hover -->
            <div
              class="pointer-events-none absolute -right-12 -top-12 h-36 w-36 rounded-full bg-primary/0 blur-2xl transition-all duration-500 group-hover:bg-primary/10"
              aria-hidden="true"
            />

            <div>
              <!-- Icon Container -->
              <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl border border-primary/20 bg-primary/10 text-primary transition-all duration-300 group-hover:scale-110 group-hover:bg-primary group-hover:text-white group-hover:shadow-md group-hover:shadow-primary/20">
                <Fragment set:html={featureIcons[i]} />
              </div>

              <!-- Title -->
              <h2 class="mt-6 text-xl font-bold tracking-tight text-ink transition-colors duration-200 group-hover:text-primary">
                {f.title}
              </h2>

              <!-- Description -->
              <p class="mt-3 text-[15px] leading-relaxed text-muted font-normal">
                {f.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- Comparison Against Competitors Section -->
    <div data-reveal class="mt-24">
      <div class="text-center">
        <h2 class="text-3xl font-bold">{t(locale, 'features.comparisonTitle')}</h2>
        <p class="mt-3 text-muted max-w-2xl mx-auto">{t(locale, 'features.comparisonSubtitle')}</p>
      </div>

      <div class="mt-10 overflow-x-auto rounded-2xl border border-ink/10 bg-surface/60 shadow-sm">
        <table class="w-full min-w-[640px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-ink/10 bg-ink/5">
              <th scope="col" class="px-6 py-4 font-semibold text-ink">{t(locale, 'features.comparisonHeaderFeature')}</th>
              <th scope="col" class="px-6 py-4 font-bold text-primary">{t(locale, 'features.comparisonOzPos')}</th>
              <th scope="col" class="px-6 py-4 font-semibold text-muted">{t(locale, 'features.comparisonOthers')}</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink/5">
            {
              comparisonRows.map((row) => (
                <tr class={row.highlight ? 'bg-primary/[0.04]' : 'hover:bg-ink/[0.02]'}>
                  <td class="px-6 py-4 font-medium text-ink">{row.feature}</td>
                  <td class="px-6 py-4 font-semibold text-primary">
                    <div class="flex items-center gap-2">
                      <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-success/15 text-xs text-success font-bold shrink-0">✓</span>
                      <span>{row.ozPos}</span>
                    </div>
                  </td>
                  <td class="px-6 py-4 text-muted">
                    <div class="flex items-center gap-2">
                      <span class="inline-flex h-5 w-5 items-center justify-center rounded-full bg-danger/15 text-xs text-danger font-bold shrink-0">✗</span>
                      <span>{row.others}</span>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- CTA Bottom Section -->
    <div data-reveal class="mt-16 text-center flex flex-col sm:flex-row items-center justify-center gap-4">
      <a
        href={download}
        class="rounded-md bg-primary px-6 py-3 font-semibold text-white transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:opacity-90 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t(locale, 'hero.ctaPrimary')}
      </a>
      <a
        href={pricing}
        class="rounded-md border border-ink/15 px-6 py-3 font-semibold text-ink transition-all duration-[120ms] ease-[cubic-bezier(0.2,0,0,1)] hover:bg-ink/5 hover:scale-[1.03] active:scale-[0.97]"
      >
        {t(locale, 'hero.ctaSecondary')}
      </a>
    </div>
  </section>
</Base>
