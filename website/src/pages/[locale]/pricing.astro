---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import PricingCard from '../../components/PricingCard.astro';
import FeatureTable from '../../components/FeatureTable.astro';
import { t } from '../../i18n';
import { pricingFor, featureRowsFor } from '../../content/pricing';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'pricingPage.title')}`;
const pricing = pricingFor(locale);
const rows = featureRowsFor(locale);
---

<Base title={pageTitle} description={t(locale, 'pageDesc.pricing')}>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'pricingPage.title')}</h1>
      <p class="mx-auto mt-3 max-w-2xl text-muted">{t(locale, 'pricingPage.subtitle')}</p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {pricing.map((tier) => <PricingCard tier={tier} />)}
    </div>

    <div class="mt-6 flex justify-center gap-6 text-sm text-muted">
      <span>✓ {t(locale, 'pricingPage.trust1')}</span>
      <span>✓ {t(locale, 'pricingPage.trust2')}</span>
    </div>

    <div class="mt-16">
      <FeatureTable rows={rows} columns={pricing} />
    </div>

    <p class="mt-6 text-center text-xs text-muted">{t(locale, 'pricingPage.note')}</p>
  </section>
</Base>
