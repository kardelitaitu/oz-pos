---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import ContactForm from '../../components/ContactForm.tsx';
import { t, dict } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'support.title')}`;
const faq = (dict(locale).support as { faq: { q: string; a: string }[] }).faq;
const email = (dict(locale).support as { email: string }).email;
---

<Base title={pageTitle} description={t(locale, 'pageDesc.support')}>
  <section class="mx-auto max-w-4xl px-4 py-16">
    <div class="text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'support.title')}</h1>
      <p class="mt-3 text-muted">{t(locale, 'support.subtitle')}</p>
    </div>

    <div class="mx-auto mt-10 max-w-2xl">
      <ContactForm client:load locale={locale} />
      <p class="mt-4 text-center text-sm text-muted">
        {t(locale, 'support.emailLabel')}:{' '}
        <a href={`mailto:${email}`} class="text-link hover:underline">
          {email}
        </a>
      </p>
    </div>

    <div class="mt-14">
      <h2 class="text-2xl font-bold">{t(locale, 'support.faqTitle')}</h2>
      <div class="mt-6 space-y-4">
        {
          faq.map((item) => (
            <details class="rounded-xl border border-ink/10 bg-surface/40 px-5 py-4">
              <summary class="cursor-pointer font-medium">{item.q}</summary>
              <p class="mt-3 text-sm leading-relaxed text-muted">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
