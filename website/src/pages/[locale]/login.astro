---
export function getStaticPaths() {
  return [{ params: { locale: 'en' } }, { params: { locale: 'id' } }];
}
import Base from '../../layouts/Base.astro';
import AuthForm from '../../components/AuthForm.tsx';
import { t } from '../../i18n';

const locale = Astro.currentLocale ?? 'en';
const pageTitle = `OZ-POS — ${t(locale, 'login.title')}`;
---

<Base title={pageTitle} description={t(locale, 'pageDesc.login')}>
  <section class="mx-auto max-w-6xl px-4 py-20">
    <div class="mb-10 text-center">
      <h1 class="text-4xl font-bold">{t(locale, 'login.title')}</h1>
      <p class="mx-auto mt-3 max-w-md text-muted">{t(locale, 'login.subtitle')}</p>
    </div>
    <AuthForm client:load locale={locale} />
  </section>
</Base>
