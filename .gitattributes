# Generated documentation (TypeDoc HTML output)
# Belts-and-suspenders with .gitignore: prevents the historical 466 HTML files
# from skewing GitHub's language stats.
/docs/html/ linguist-vendored

# Coverage reports (generated HTML/JSON)
/coverage/ linguist-vendored
/ui/coverage/ linguist-vendored
/apps/license-server/coverage.html linguist-vendored

# Rust build artifacts
/target/ linguist-vendored

# Node build output & dependencies
/ui/dist/ linguist-vendored
/ui/node_modules/ linguist-vendored

# Shell entrypoints must stay LF so the `#!/bin/sh` shebang survives
# Docker builds on Windows checkouts (core.autocrlf would otherwise
# convert them to CRLF and break container startup with
# "exec ...: no such file or directory").
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
scripts/*.sh text eol=lf
