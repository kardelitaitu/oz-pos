# Belts-and-suspenders with .gitignore: prevents the historical 466 HTML files
# from skewing GitHub's language stats.
/docs/html/ linguist-vendored

# Coverage reports (generated HTML/JSON)
/coverage/ linguist-vendored
/ui/coverage/ linguist-vendored
/apps/license-server/coverage.html linguist-vendored

# Rust build artifacts
/target/ linguist-vendored

# Node build output & dependencies
/ui/dist/ linguist-vendored
/ui/node_modules/ linguist-vendored

# ── Line endings: LF everywhere ───────────────────────────────────────
# The index already stores every text file as LF. This pins the WORKING
# TREE to LF on every platform, overriding the system-level
# core.autocrlf=true that makes Windows checkouts CRLF. Without it, any
# LF-writing tool (editors, Codebuff, gofmt/cargo fmt) leaves files that
# git flags as "modified" with a zero content diff — the recurring
# CRLF/LF noise in `git status` (and the "LF will be replaced by CRLF"
# warning on every add/commit).
* text=auto eol=lf

# Windows batch files: cmd.exe mis-parses labels/goto in LF-only batch
# files, so check them out CRLF (the index still stores LF).
*.bat text eol=crlf
*.cmd text eol=crlf
