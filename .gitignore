# Build artifacts
/target/
/crates/*/target/
# Temporary isolated Cargo targets used by verification runs.
/target-topology-phase10/
/target-plan-e3/
/target-tdd-round121/
/apps/license-server/license-server.exe
/ui/playwright-report
/ui/test-results
/ui/e2e-results
/ui/.e2e-auth.json

# Cargo workspaces have a single Cargo.lock at the workspace root, not
# one per crate. OZ-POS ships binaries (oz-cli, and the Tauri app in
# src-tauri/) so the lockfile is committed for reproducible builds.
# Do NOT add a per-crate `Cargo.lock` line — they don't exist and the
# pattern would never match.
# Exception: the fuzz/ crate is a standalone cargo-fuzz workspace (its own
# `[workspace]` table + nightly toolchain pin), so it builds its own
# target/ and Cargo.lock locally; both are dev-only artifacts.
/fuzz/target/
/fuzz/Cargo.lock

# fuzz/hfuzz/ — honggfuzz campaign crate (stable-toolchain sibling of the
# cargo-fuzz crate). Entirely local/dev-only: instrumented build artifacts,
# growing corpora, workspaces, and crash reports all live under it.
/fuzz/hfuzz/

# Local state
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Env files — keep the committed template trackable (negation below).
.env
.env.*
!.env.example
*.key
*.pem
*.keystore
*.jks
*.p12
secrets/

# AI agents
/.commandcode/
/.vscode/
/.prime/
/.freebuff/

# Editor — shared settings may be committed, everything else is local.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
# Merge/backup artifacts
*.orig
*.rej
*~

# OS
.DS_Store
Thumbs.db
# Windows reserved device name — git picks it up as untracked even though
# the file doesn't exist on disk. Keeping it ignored silences the noise.
nul
ui/nul
ui/src/nul

# Rust
**/*.rs.bk

# Coverage
/coverage/
/ui/coverage/
/ui/*coverage*.txt
/ui/new_*.txt
/ui/snippet.txt
/apps/license-server/coverage.html

# Test artifacts
*.profraw
*.gcda
*.gcno

# Log files (runtime, test output, CI gates, etc.)
*.log
# Vitest profiling output (vitest --reporter=json)
/vitest-profile.json
# Skill drift guard report (generated by .agents/skills/skill-drift-guard/scripts/detect.sh)
# /skill-drift-report.md — committed as a baseline; keep it trackable

# Generated documentation (TypeDoc HTML output)
/docs/html/

# Generated documentation portal (mdBook) — see documentation.md at repo root.
# The canonical docs live in docs/*.md + docs/decisions/; the book source and
# output are regenerated by scripts/build-docs.sh|.ps1 on every build.
/docs/book/
/docs/src/api/
/docs/src/guides/
/docs/src/decisions/
/docs/src/SUMMARY.md

# Graph analysis artifacts (generated by graphify)
/graphify-out/
# Graphify rebuild hooks — local-only tooling; installed via `graphify hook
# install`. Kept out of the repo so the remote never carries graphify.
.githooks/post-commit
.githooks/post-checkout
# Root-level scratch files/dirs
/temp.go
/tmp/

# Tauri — generated platform code (Android/iOS)
# The generated scaffold under apps/*/gen/ is COMMITTED so CI and
# contributors don't need the Tauri CLI installed to build (same policy as
# the icons below). The scaffold ships its own committed .gitignore that
# already excludes Gradle/Kotlin build junk (build/, .gradle/, .kotlin/,
# captures/, local.properties, generated/ code, *.so, tauri.conf.json, ...);
# only what that misses is listed here:
apps/tablet-client/gen/android/buildSrc/.kotlin/
# apps/*/icons/*.png   ← committed, do not ignore
# apps/*/icons/*.ico   ← committed, do not ignore

# UI
/ui/node_modules/
/ui/.vite/
/ui/.eslintcache
/ui/.stylelintcache
# ui/vite.config.js is emitted from vite.config.ts by the TS build.
ui/vite.config.js
ui/tsconfig.tsbuildinfo
ui/tsconfig.node.tsbuildinfo

# Root-level node deps & Vite cache (some tooling installs at root)
/node_modules/
/package-lock.json
/.vite/

# AUDIT-28 RELEASE-04: standalone updater-compat harness (mirrors /fuzz/
# exception) — its own workspace, so target/ + Cargo.lock are dev-only.
/scripts/updater-compat-check/target/
/scripts/updater-compat-check/Cargo.lock

# Python bytecode caches (previously committed by mistake; untracked 2026-08-03)
__pycache__/
*.pyc

# Python tooling (scripts/ and ad-hoc tooling)
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
htmlcov/
